<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Preparation time sits next to the Sales Lead Time it defaults to, so the
         merchant sees both numbers and can tell which one the promise uses. -->
    <record id="product_template_form_delivery_promise" model="ir.ui.view">
        <field name="name">product.template.form.delivery.promise</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_delay']" position="after">
                <field name="ships_in_days"/>
            </xpath>
        </field>
    </record>

</odoo>
