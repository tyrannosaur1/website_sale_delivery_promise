<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Website settings: the promise is configured per website, so the fields
         live on the website form rather than on the global settings page. A
         multi-site merchant gets one cut-off and one holiday calendar per shop. -->
    <record id="view_website_form_delivery_promise" model="ir.ui.view">
        <field name="name">website.form.delivery.promise</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Delivery Promise" name="page_delivery_promise">
                    <group>
                        <group string="Promise">
                            <field name="delivery_promise_enabled"/>
                            <field name="delivery_cutoff_hour"/>
                            <field name="delivery_tz"/>
                        </group>
                        <group string="Days orders are prepared">
                            <field name="delivery_open_mon"/>
                            <field name="delivery_open_tue"/>
                            <field name="delivery_open_wed"/>
                            <field name="delivery_open_thu"/>
                            <field name="delivery_open_fri"/>
                            <field name="delivery_open_sat"/>
                            <field name="delivery_open_sun"/>
                        </group>
                    </group>
                    <separator string="Holidays"/>
                    <field name="delivery_holiday_ids">
                        <tree editable="bottom">
                            <field name="date"/>
                            <field name="name"/>
                        </tree>
                    </field>
                    <separator string="Extra transit days per country"/>
                    <field name="delivery_country_extra_ids">
                        <tree editable="bottom">
                            <field name="country_id"/>
                            <field name="extra_days"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
